# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000

# Public address of the storefront (used for canonical URLs, sitemap, emails and the CSRF origin check).
# In development this is the Vite dev server.
PUBLIC_URL=http://localhost:5173
# Extra allowed origins, comma-separated (e.g. a staging domain).
EXTRA_ORIGINS=

MONGODB_URI=mongodb://127.0.0.1:27017/gold_shop

# REQUIRED in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Behind a reverse proxy / load balancer, the number of proxy hops to trust (defaults to 1 in production).
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Where uploaded images are stored (relative to server/). Use persistent storage in production.
# UPLOAD_DIR=uploads

# ---- Cloudflare Pages + Cloud Run only (docs/DEPLOYMENT.md, option C). Leave blank otherwise. ----
# Shared with the Pages function: requests without it (e.g. straight to *.run.app) are refused.
PROXY_SECRET=
# Sent by Cloud Scheduler to POST /api/internal/jobs every 5 minutes.
CRON_SECRET=

# ---- Razorpay (online payments). Leave blank to disable online payment. ----
# Test keys start with rzp_test_, live keys with rzp_live_. Dashboard → Account & Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://YOUR_DOMAIN/api/payments/razorpay/webhook with events:
#   payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Minutes an unpaid online order holds its stock before being released.
ORDER_RESERVATION_MINUTES=30

# ---- Email (order confirmations, status updates, password resets). Leave blank to disable. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Store <orders@yourstore.in>"
# Where new-order and enquiry notifications go (defaults to the store email in settings).
ORDER_NOTIFY_EMAIL=

# Look up city/state from the PIN code using India Post's public API (api.postalpincode.in).
PINCODE_LOOKUP=false

# Used by `npm run seed` to create the first admin account (optional).
ADMIN_EMAIL=
ADMIN_PASSWORD=
