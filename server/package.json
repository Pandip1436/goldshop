{
  "name": "@goldshop/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed.ts --demo",
    "seed:clear-demo": "tsx scripts/seed.ts --clear-demo",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@goldshop/shared": "1.0.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.5",
    "multer": "2.4.0",
    "nodemailer": "7.0.13",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
